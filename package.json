{
  "name": "desktop-hisho",
  "version": "0.1.0",
  "description": "Personal desktop assistant wrapping Claude Code — quick tasks, nag reminders, message aggregation, terminal.",
  "main": "./out/main/index.js",
  "author": "Miles Christensen",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f --only better-sqlite3",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "release:patch": "npm version patch && npm run release",
    "release:minor": "npm version minor && npm run release"
  },
  "build": {
    "appId": "com.mileschristensen.hisho",
    "productName": "Hisho",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "miles-christensen-anglepoint",
      "repo": "Hisho"
    },
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/icon.png",
      "resources/app.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hisho"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.9",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
